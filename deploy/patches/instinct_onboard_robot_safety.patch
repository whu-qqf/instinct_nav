diff --git a/instinct_onboard/ros_nodes/realsense.py b/instinct_onboard/ros_nodes/realsense.py
index 3afe0ec..e6f7050 100644
--- a/instinct_onboard/ros_nodes/realsense.py
+++ b/instinct_onboard/ros_nodes/realsense.py
@@ -84,8 +84,19 @@ class RealsenseCamera(CameraBase):
         if self.color_resolution is not None:
             fps_values.append(self.color_fps)
         effective_fps = min(fps_values) if fps_values else 30
-        timeout_ms = int(1000 / effective_fps)
-        frames = self.pipeline.wait_for_frames(timeout_ms * 2)
+        # Two frame periods (32 ms at 60 Hz) is too aggressive for a USB
+        # camera on a loaded onboard computer: an otherwise healthy stream can
+        # occasionally miss that deadline because of USB or scheduler jitter.
+        # Give the device a modest grace period, and treat a frame timeout as a
+        # dropped frame rather than a fatal camera-process error.  The parent
+        # node's freshness watchdog still stops autonomy if frames remain stale.
+        timeout_ms = max(int(1000 / effective_fps) * 2, 100)
+        try:
+            frames = self.pipeline.wait_for_frames(timeout_ms)
+        except RuntimeError as exc:
+            if "Frame didn't arrive" in str(exc):
+                return False
+            raise
 
         got_data = False
 
